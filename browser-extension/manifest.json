{
  "manifest_version": 3,
  "name": "EdgePilot Browser Monitor",
  "version": "1.2.0",
  "description": "Adds local market-news context, Nexus trade capture, and monitored signal decisions to EdgePilot.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": [
    "https://*.tradingview.com/*",
    "https://tradingview.com/*",
    "https://ffn.nexusprop.com/*",
    "https://edgepilot-ai-trader.grangerdeil.chatgpt.site/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tradingview.com/*",
        "https://tradingview.com/*",
        "https://ffn.nexusprop.com/*",
        "https://edgepilot-ai-trader.grangerdeil.chatgpt.site/*",
        "http://localhost:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
